@model SEMP_Aplikacija.ViewModels.EpizodaViewModel
@{
    ViewData["Title"] = "Dodaj epizodu";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card bg-dark text-white border-warning">
            <div class="card-header bg-warning text-dark fw-bold">Dodaj novu epizodu</div>
            <div class="card-body p-4">
                <form asp-action="Dodaj" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <div class="mb-3">
                        <label asp-for="Naslov" class="form-label text-warning">Naslov</label>
                        <input asp-for="Naslov" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="Naslov" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Opis" class="form-label text-warning">Opis</label>
                        <textarea asp-for="Opis" class="form-control bg-dark text-white border-secondary" rows="4"></textarea>
                        <span asp-validation-for="Opis" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DatumPremijere" class="form-label text-warning">Datum premijere</label>
                        <input asp-for="DatumPremijere" type="date" class="form-control bg-dark text-white border-secondary" />
                        <span asp-validation-for="DatumPremijere" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-grow-1">Sacuvaj</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Otkazi</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
