@model List<SEMP_Aplikacija.ViewModels.EpizodaViewModel>
@{
    ViewData["Title"] = "Upravljanje epizodama";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-warning">⚙ Upravljanje epizodama</h2>
    <a asp-action="Dodaj" class="btn btn-warning">+ Dodaj novu epizodu</a>
</div>

<div class="table-responsive">
    <table class="table table-dark table-striped table-hover">
        <thead class="table-warning text-dark">
            <tr>
                <th>ID</th>
                <th>Naslov</th>
                <th>Opis</th>
                <th>Datum premijere</th>
                <th>ZarnIdz</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ep in Model)
            {
                <tr>
                    <td>@ep.Id</td>
                    <td>@ep.Naslov</td>
                    <td>@(ep.Opis.Length > 60 ? ep.Opis.Substring(0, 60) + "..." : ep.Opis)</td>
                    <td>@ep.ZarnIdz</td>
                    <td>@ep.DatumPremijere.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-action="Izmeni" asp-route-id="@ep.Id" class="btn btn-sm btn-primary me-1">Izmeni</a>
                        <form asp-action="Obrisi" method="post" class="d-inline"
                              onsubmit="return confirm('Da li ste sigurni da zelite da obrisete epizodu @ep.Naslov?');">
                            <input type="hidden" name="id" value="@ep.Id" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Obrisi</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
