@model SEMP_Aplikacija.ViewModels.PrijavaViewModel
@{
    ViewData["Title"] = "Prijava";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card bg-dark text-white border-warning">
            <div class="card-header bg-warning text-dark fw-bold text-center fs-5">
                Prijava na nalog
            </div>
            <div class="card-body p-4">
                <form asp-action="Prijava" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="KorisnickoIme" class="form-label text-warning">Korisnicko ime</label>
                        <input asp-for="KorisnickoIme" class="form-control bg-dark text-white border-secondary" placeholder="Unesite korisnicko ime" />
                        <span asp-validation-for="KorisnickoIme" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Lozinka" class="form-label text-warning">Lozinka</label>
                        <input asp-for="Lozinka" class="form-control bg-dark text-white border-secondary" placeholder="Unesite lozinku" />
                        <span asp-validation-for="Lozinka" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 fw-bold">Prijavi se</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
