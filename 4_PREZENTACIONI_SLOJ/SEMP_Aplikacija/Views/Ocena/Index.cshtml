@model List<SEMP_Aplikacija.ViewModels.OcenaViewModel>
@{
    ViewData["Title"] = "Oceni epizode";
}

<h2 class="text-warning mb-4">🎬 Oceni epizode</h2>

@if (!Model.Any())
{
    <div class="alert alert-dark border-warning">Nema epizoda za ocenjivanje.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover">
            <thead class="table-warning text-dark">
                <tr>
                    <th>Naslov</th>
                    <th class="text-center">Prosecna ocena</th>
                    <th class="text-center">Akcija</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ep in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold">@ep.NaslovEpizode</td>
                        <td class="text-center align-middle">
                            @if (ep.ProsecnaOcena > 0)
                            {
                                <span class="badge bg-warning text-dark fs-6">
                                    ★ @ep.ProsecnaOcena.ToString("F1")
                                </span>
                            }
                            else
                            {
                                <span class="text-white">Bez ocena</span>
                            }
                        </td>
                        <td class="text-center align-middle">
                            <a asp-action="Oceni" asp-route-id="@ep.EpizodaId"
                               class="btn btn-sm btn-warning">
                                ★ Oceni
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-action="RangLista" class="btn btn-outline-warning">🏆 Pogledaj rang listu</a>
</div>
