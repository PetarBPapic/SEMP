@model SEMP_Aplikacija.ViewModels.EpizodaRangListaViewModel
@{
    ViewData["Title"] = "Rang lista";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-warning">🏆 Rang lista epizoda</h2>
    <small class="text-muted">Azurirano: @Model.DatumAzuriranja</small>
</div>

<div class="mb-5">
    <h3 class="text-warning border-bottom border-warning pb-2 mb-3">🎯 Top 10 – Najbolje ocenjene epizode</h3>

    @if (!Model.Top10.Any())
    {
        <div class="alert alert-dark border-warning">
            Nema dovoljno ocena za prikaz top liste. Budi prvi i oceni!
        </div>
    }
    else
    {
        <div class="row g-3 mb-3">
            @for (int i = 0; i < Model.Top10.Count; i++)
            {
                var ep = Model.Top10[i];
                int mesto = i + 1;
                string medalja = mesto == 1 ? "🥇" : mesto == 2 ? "🥈" : mesto == 3 ? "🥉" : $"#{mesto}";
                <div class="col-md-6">
                    <div class="card bg-dark text-white h-100 @(mesto <= 3 ? "border-warning" : "border-secondary")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="fs-4 me-2">@medalja</span>
                                    <strong>@ep.Naslov</strong>
                                </div>
                                <span class="badge bg-warning text-dark fs-6 ms-2">
                                    ★ @ep.ProsecnaOcena.ToString("F1")
                                </span>
                            </div>
                            <p class="text-muted small mt-2 mb-1">
                                @(ep.Opis.Length > 80 ? ep.Opis.Substring(0, 80) + "..." : ep.Opis)
                            </p>
                            <small class="text-muted">@ep.BrojOcena ocena | @ep.DatumPremijere.ToString("dd.MM.yyyy")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div>
    <h3 class="text-warning border-bottom border-warning pb-2 mb-3">
        📋 Sve epizode – od najbolje do najgore ocenjene
    </h3>

    @if (!Model.SveSortirane.Any())
    {
        <div class="alert alert-dark">Nema epizoda sa ocenama.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover">
                <thead class="table-warning text-dark">
                    <tr>
                        <th class="text-center">#</th>
                        <th>Naslov</th>
                        <th>Opis</th>
                        <th class="text-center">Prosecna ocena</th>
                        <th class="text-center">Broj ocena</th>
                        <th class="text-center">Datum</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.SveSortirane.Count; i++)
                    {
                        var ep = Model.SveSortirane[i];
                        int mesto = i + 1;
                        <tr class="@(mesto == 1 ? "table-warning text-dark" : "")">
                            <td class="text-center fw-bold">
                                @(mesto == 1 ? "🥇" : mesto == 2 ? "🥈" : mesto == 3 ? "🥉" : mesto.ToString())
                            </td>
                            <td class="fw-bold">@ep.Naslov</td>
                            <td class="text-white small">
                                @(ep.Opis.Length > 60 ? ep.Opis.Substring(0, 60) + "..." : ep.Opis)
                            </td>
                            <td class="text-center">
                                <span class="badge @(mesto == 1 ? "bg-dark text-warning" : "bg-warning text-dark") fs-6">
                                    ★ @ep.ProsecnaOcena.ToString("F2")
                                </span>
                            </td>
                            <td class="text-center">@ep.BrojOcena</td>
                            <td class="text-center">@ep.DatumPremijere.ToString("dd.MM.yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Context.Session.GetString("korisnik") != null)
{
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-warning">★ Oceni epizode</a>
    </div>
}
else
{
    <div class="mt-3 p-3 bg-dark rounded border border-secondary text-center">
        <p class="text-muted mb-2">Zelis da utices na rang listu?</p>
        <a asp-controller="Nalog" asp-action="Prijava" class="btn btn-warning">Prijavi se i oceni</a>
    </div>
}
