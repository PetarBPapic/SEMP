@model SEMP_Aplikacija.ViewModels.GreskaViewModel
@{
    ViewData["Title"] = "Greška";
}

<div class="text-center py-5">
    <h1 class="display-4 text-danger">Greška!</h1>
    <p>Došlo je do greške prilikom obrade zahteva.</p>
    @if (Model.PrikaziRequestId)
    {
        <p>
            <strong>ID zahteva:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
