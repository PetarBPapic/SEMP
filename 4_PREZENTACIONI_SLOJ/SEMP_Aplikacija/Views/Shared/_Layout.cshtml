<!DOCTYPE html>
<html lang="sr-Latn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SEBICAN Reviews</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom border-warning border-2">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-warning" asp-controller="Pocetna" asp-action="Index">
                    ★ SEBICAN Reviews
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Pocetna" asp-action="Index">Pocetna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ocena" asp-action="RangLista">🏆 Rang lista</a>
                        </li>
                        @if (Context.Session.GetString("korisnik") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Ocena" asp-action="Index">Oceni epizode</a>
                            </li>
                        }
                        @if (Context.Session.GetString("uloga") == "admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-controller="Epizoda" asp-action="Index">⚙ Upravljanje epizodama</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("korisnik") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-success">
                                    👤 @Context.Session.GetString("korisnik")
                                    @if (Context.Session.GetString("uloga") == "admin")
                                    {
                                        <span class="badge bg-warning text-dark ms-1">admin</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Nalog" asp-action="Odjava">Odjava</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Nalog" asp-action="Prijava">Prijava</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 mb-5">
        @if (TempData["Poruka"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Poruka"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>

    <footer class="footer bg-dark text-white py-3 mt-auto border-top border-warning">
        <div class="container text-center">
            <span class="text-muted">© @DateTime.Now.Year SEBICAN Reviews - Slojevita arhitektura (4 sloja)</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
