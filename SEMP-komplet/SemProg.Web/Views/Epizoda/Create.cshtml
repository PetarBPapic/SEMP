@model SemProg.BLL.DtoOvi.EpizodaDto
@{ ViewData["Title"] = "Dodaj epizodu"; }
<h2>Dodaj epizodu</h2>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Naslov" class="form-label"></label>
                <input asp-for="Naslov" class="form-control" />
                <span asp-validation-for="Naslov" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Opis" class="form-label"></label>
                <textarea asp-for="Opis" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="DatumPremijere" class="form-label"></label>
                <input asp-for="DatumPremijere" class="form-control" type="date" />
                <span asp-validation-for="DatumPremijere" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-warning">Sačuvaj</button>
            <a asp-action="Index" class="btn btn-secondary">Odustani</a>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("~/Views/Deljeno/_SkriptaValidacije.cshtml"); } }
