@model SemProg.BLL.DtoOvi.EpizodaDto
@{
    ViewData["Title"] = "Izmeni epizodu";
}
<h2>Izmeni epizodu</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Naslov" class="form-label"></label>
        <input asp-for="Naslov" class="form-control" />
        <span asp-validation-for="Naslov" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Opis" class="form-label"></label>
        <textarea asp-for="Opis" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Opis" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DatumPremijere" class="form-label"></label>
        <input asp-for="DatumPremijere" type="date" class="form-control" />
        <span asp-validation-for="DatumPremijere" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Sačuvaj izmene</button>
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>
